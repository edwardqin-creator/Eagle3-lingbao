# 复制为 configs/lingbao.env 后修改。下面默认值与 TENCENT64 当前目录一致。

# ===== 运行时 =====
SPEC_FORGE_ROOT=/workspace/SpecForge
SPEC_FORGE_PYTHON=/workspace/SpecForge/.venv/bin/python
SPEC_FORGE_BIN=/workspace/SpecForge/.venv/bin/specforge
TARGET_MODEL=/data/home/leonardoqin/models/lingbao-response
SERVED_MODEL_NAME=kaiwu-llm-model

# ===== 本轮实验目录 =====
DATA_ROOT=/data/home/leonardoqin/datasets/lingbao_eagle3_data
EXPERIMENT_NAME=lingbao-eagle3-i8k-e5-v1

# 01 数据准备：原始日志每行形如 {"msg":"... payload: {...}"}
RAW_DATA=/data/home/leonardoqin/datasets/lingbao_prd_prompts_260612.ndjson
REQUEST_DIR=${DATA_ROOT}/requests_v2
TRAIN_SIZE=30000
VAL_SIZE=3000
SPLIT_SEED=20260723

# 02 Target 重放：支持单服务或多个 TP2 副本。
# 多组 GPU/端口用空格分隔，数量必须一致。默认使用后 6 张卡。
REPLAY_GPU_GROUPS="2,3 4,5 6,7"
REPLAY_PORTS="33100 33110 33120"
REPLAY_TP_SIZE=2
REPLAY_CONTEXT_LENGTH=16384
REPLAY_MEM_FRACTION=0.80
REPLAY_MAX_RUNNING_REQUESTS=8
REPLAY_CONCURRENCY_PER_SERVER=8
REPLAY_OUTPUT=${DATA_ROOT}/regenerated_v2/train_eagle3.jsonl
REPLAY_ERROR_OUTPUT=${DATA_ROOT}/regenerated_v2/train_eagle3.errors.jsonl

# ===== 03 训练资产 =====
DRAFT_CONFIG=${DATA_ROOT}/configs/qwen3.5-35b-a3b-eagle3-i8k-v1.json
PRETOKENIZED_DATA=${DATA_ROOT}/pretokenized_v2/train_eagle3_tokens_10240.jsonl
VOCAB_MAPPING=${DATA_ROOT}/cache/vocab_mapping/qwen3.5-35b-a3b-eagle3-v2.pt
MASK_POLICY=target-faithful
MAX_LENGTH=10240
EXPECTED_TRAIN_RECORDS=30000

# ===== 04 训练 =====
TRAIN_CONFIG=${DATA_ROOT}/configs/${EXPERIMENT_NAME}.yaml
TRAIN_OUTPUT=${DATA_ROOT}/outputs/${EXPERIMENT_NAME}
TRAIN_LOG_DIR=${DATA_ROOT}/train_logs
TRAIN_GPU_DEVICES="4,5,6,7"
CAPTURE_GPU_DEVICES="2,3"
CAPTURE_PORT=33200
CAPTURE_TP_SIZE=2
MOONCAKE_RPC_PORT=36551
MOONCAKE_METADATA_PORT=36880
MOONCAKE_METRICS_PORT=36903

NUM_EPOCHS=5
BATCH_SIZE=1
ACCUMULATION_STEPS=1
LEARNING_RATE=0.0001
WARMUP_RATIO=0.015
MAX_GRAD_NORM=0.5
TTT_LENGTH=7
ATTENTION_BACKEND=fa
SAVE_INTERVAL=2500
MAX_CHECKPOINTS=9
LOG_INTERVAL=10

# 你们当前在线训练成功依赖本地 SpecForge 补丁允许 streaming EAGLE3 使用 compact teacher。
# 如果使用未修改的官方 SpecForge，设为 false；长序列显存可能不足，此时改走离线训练或降长度。
COMPACT_TEACHER=true
COMPACT_TEACHER_CHUNK_SIZE=4096

# 训练完成后由 04_train.sh export 使用。
EXPORT_CHECKPOINT=${TRAIN_OUTPUT}/${EXPERIMENT_NAME}-latest
EXPORT_DIR=/data/home/leonardoqin/models/exports/${EXPERIMENT_NAME}-sglang

# ===== 05 公平验收 =====
# Validation 用于选 checkpoint/steps/top-k/draft-tokens；Test 只做一次冻结验收。
VAL_DATA=${REQUEST_DIR}/val_requests.jsonl
TEST_DATA=${REQUEST_DIR}/test_requests.jsonl
EVAL_GPU_DEVICES="6,7"
EVAL_TP_SIZE=2
EVAL_PORT=33300
EVAL_CONTEXT_LENGTH=16384
EVAL_MEM_FRACTION=0.60
EVAL_LIMIT=500
EVAL_WARMUP=8
EVAL_CONCURRENCIES="1 2 4 8"
EVAL_SAMPLE_SEED=20260723
EVAL_DRAFT_MODEL=${EXPORT_DIR}
# 业务评测保持为空；Decode 微基准可在命令前设置这两个变量。
EVAL_FIXED_OUTPUT_TOKENS=
EVAL_IGNORE_EOS=0

# EAGLE3 serving 参数。必须先在 Validation 上选择，然后冻结用于 Test。
SPEC_NUM_STEPS=3
SPEC_TOPK=4
SPEC_DRAFT_TOKENS=16

# 透明验收门槛；接受长度不是唯一门槛。
GATE_MIN_ACCEPT_LENGTH=2.0
GATE_MIN_OUTPUT_SPEEDUP=1.0
GATE_MAX_E2E_REGRESSION_PCT=5.0
